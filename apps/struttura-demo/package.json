{
  "name": "@xndrjs/struttura-demo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "codegen": "struttura codegen --architecture ./architecture/architecture.ts --out ./architecture/populate-api.generated.ts",
    "apply": "struttura apply --population ./architecture/population.ts --architecture-dir ./architecture --materialization-root ./src",
    "inspect": "struttura inspect --population ./architecture/population.ts --architecture-dir ./architecture --materialization-root ./src",
    "materialize": "pnpm run codegen && pnpm run apply",
    "lint:project": "pnpm --filter struttura-demo-project lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@xndrjs/struttura": "workspace:^",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
