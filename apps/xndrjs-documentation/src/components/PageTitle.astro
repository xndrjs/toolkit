---
import {
  blogTagPathname,
  formatBlogDate,
  getEntryBlogTags,
  isBlogPost,
} from "../utils/blog-posts";

/** Matches Starlight’s page title anchor (`@astrojs/starlight/constants`). */
const PAGE_TITLE_ID = "_top";

const route = Astro.locals.starlightRoute;
const { entry } = route;
const data = entry.data;
const showMeta = isBlogPost(entry);
const author =
  typeof data.author === "string" && data.author.length > 0
    ? data.author
    : null;
const date = data.date instanceof Date ? data.date : null;
const tags = showMeta ? getEntryBlogTags(entry) : [];
---

<h1 id={PAGE_TITLE_ID}>{data.title}</h1>
{
  showMeta && (author || date) ? (
    <p class="blog-page-meta">
      {author ? <span class="blog-page-meta__author">{author}</span> : null}
      {author && date ? (
        <span class="blog-page-meta__sep" aria-hidden="true">
          ·
        </span>
      ) : null}
      {date ? (
        <time class="blog-page-meta__date" datetime={date.toISOString()}>
          {formatBlogDate(date)}
        </time>
      ) : null}
    </p>
  ) : null
}
{
  tags.length > 0 ? (
    <ul class="blog-page-tags" aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <a class="blog-page-tags__tag" href={blogTagPathname(tag)}>
            {tag}
          </a>
        </li>
      ))}
    </ul>
  ) : null
}

<style>
  @layer starlight.core {
    h1 {
      margin-top: 1rem;
      font-size: var(--sl-text-h1);
      line-height: var(--sl-line-height-headings);
      font-weight: 600;
      color: var(--sl-color-white);
    }
  }

  .blog-page-meta {
    margin: 0.35rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.5;
  }

  .blog-page-meta__author {
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }

  .blog-page-meta__sep {
    margin: 0 0.35rem;
  }

  .blog-page-tags {
    list-style: none;
    padding: 0;
    margin: 0.65rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    min-width: 0;
    max-width: 100%;
  }

  .blog-page-tags li {
    margin: 0;
    min-width: 0;
    max-width: 100%;
  }

  .blog-page-tags__tag {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
    font-size: var(--sl-text-xs);
    font-weight: 500;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-gray-5);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .blog-page-tags__tag:hover {
    border-color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-5);
  }
</style>
