---
/**
 * Capability-oriented package map for the splash homepage.
 * Groups packages by problem domain rather than architectural layer.
 */
const sections = [
  {
    id: "modeling",
    label: "Modeling",
    blurb: "Domain models, invariants, and schema-backed guarantees",
    href: "/latest/modeling/overview/",
    packages: [
      { name: "domain", href: "/latest/modeling/overview/" },
      { name: "domain-zod", href: "/latest/modeling/adapters/zod/" },
      { name: "domain-valibot", href: "/latest/modeling/adapters/valibot/" },
      { name: "domain-ajv", href: "/latest/modeling/adapters/ajv/" },
    ],
  },
  {
    id: "resource-orchestration",
    label: "Resource Orchestration",
    blurb: "Addressable resources, graph resolution, and declarative orchestration",
    href: "/latest/resource-orchestration/addressable-resources/",
    packages: [
      { name: "addressable-resources", href: "/latest/resource-orchestration/addressable-resources/" },
      { name: "resource-graph-resolver", href: "/latest/resource-orchestration/resource-graph-resolver/" },
      { name: "ziel", href: "/latest/resource-orchestration/ziel/" },
    ],
  },
  {
    id: "localization",
    label: "Localization",
    blurb: "Localization primitives and framework integrations",
    href: "/latest/localization/i18n/",
    packages: [
      { name: "i18n", href: "/latest/localization/i18n/" },
      { name: "i18n-react", href: "/latest/localization/i18n/react/" },
    ],
  },
  {
    id: "integrations",
    label: "Integrations",
    blurb: "Bridges between external systems and xndrjs",
    href: "/latest/integrations/contentful-to-zod/",
    packages: [
      { name: "contentful-to-zod", href: "/latest/integrations/contentful-to-zod/" },
    ],
  },
  {
    id: "concurrency",
    label: "Concurrency / Workflows",
    blurb: "Task composition and controlled concurrent execution",
    href: "/latest/concurrency/tasks/",
    packages: [
      { name: "tasks", href: "/latest/concurrency/tasks/" },
    ],
  },
] as const;
---

<figure class="arch-map not-content" aria-label="xndrjs package map by capability">
  <div class="arch-map__rings">
    {
      sections.map((section) => (
        <div class:list={["arch-map__ring", `arch-map__ring--${section.id}`]}>
          <div class="arch-map__ring-head">
            <a class="arch-map__layer-link" href={section.href}>
              <span class="arch-map__layer-name">{section.label}</span>
              <span class="arch-map__layer-blurb">{section.blurb}</span>
            </a>
          </div>
          {/* div grid — avoid Starlight markdown `ul`/`li` spacing that misaligns the first item */}
          <div class="arch-map__packages">
            {section.packages.map((pkg) => (
              <a class="arch-map__package" href={pkg.href}>
                <span class="arch-map__scope">@xndrjs/</span>
                <span class="arch-map__pkg">{pkg.name}</span>
              </a>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</figure>

<style>
  .arch-map {
    margin: 0;
  }

  .arch-map__rings {
    display: grid;
    gap: 1.25rem;
  }

  .arch-map__ring {
    position: relative;
    border-radius: 0.5rem;
    padding: 1rem 1.15rem 1.05rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-sidebar);
    transition: border-color 0.15s ease;
  }

  .arch-map__ring:hover {
    border-color: var(--ring-accent);
  }

  .arch-map__ring--modeling {
    --ring-accent: var(--sl-color-green, #3dd68c);
  }

  .arch-map__ring--resource-orchestration {
    --ring-accent: var(--sl-color-orange, #f5a524);
  }

  .arch-map__ring--localization {
    --ring-accent: var(--sl-color-accent-high, #7c9cff);
  }

  .arch-map__ring--integrations {
    --ring-accent: var(--sl-color-purple, #b57bff);
  }

  .arch-map__ring--concurrency {
    --ring-accent: var(--sl-color-red, #f76c6c);
  }

  .arch-map__ring-head {
    margin-bottom: 0.75rem;
  }

  .arch-map__layer-link {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  .arch-map__ring:hover .arch-map__layer-name {
    color: var(--ring-accent);
  }

  .arch-map__layer-name {
    font-family: var(--xndr-brand-mono);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  .arch-map__layer-blurb {
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
    line-height: 1.35;
  }

  .arch-map__packages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr));
    gap: 0.45rem;
    align-items: stretch;
  }

  .arch-map__package {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    align-items: center;
    margin: 0;
    width: 100%;
    min-height: 2.25rem;
    padding: 0.35rem 0.65rem;
    box-sizing: border-box;
    border-radius: 0.4rem;
    border: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    text-decoration: none;
    font-family: var(--xndr-brand-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: border-color 0.15s ease;
  }

  .arch-map__package:hover {
    border-color: var(--sl-color-gray-2);
  }

  .arch-map__scope {
    color: var(--sl-color-gray-3);
    font-weight: 500;
  }

  .arch-map__pkg {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 50rem) {
    .arch-map__packages {
      grid-template-columns: 1fr;
    }
  }
</style>
