query PageDetail(pageId: EntryId) {
  context {
    spaceId: SpaceId
    environmentId: EnvironmentId
    locale: Locale
  }

  root Page(
    spaceId: context.spaceId,
    environmentId: context.environmentId,
    id: pageId,
    locale: context.locale
  )

  on Page p {
    id
    title
    expand menu: Menu(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.menuId,
      locale: @p.locale
    )
    expand footer: Footer(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.footerId,
      locale: @p.locale
    )
    expand strips: each link in p.strips (
      Entry(
        spaceId: @p.spaceId,
        environmentId: @p.environmentId,
        id: link.id,
        locale: @p.locale
      )
    )
    expand related: each ref in p.related (
      CustomReference(
        ref: ref,
        locale: @p.locale
      )
    )
  }

  on Hero h {
    id
    title
    expand image: Asset(
      spaceId: context.spaceId,
      environmentId: context.environmentId,
      id: h.imageId,
      locale: @h.locale
    )
  }

  on Menu m {
    id
    title
    expand logo: Asset(
      spaceId: context.spaceId,
      environmentId: context.environmentId,
      id: m.logoId,
      locale: @m.locale
    )
  }

  on Footer f {
    id
    title
    expand logo: Asset(
      spaceId: context.spaceId,
      environmentId: context.environmentId,
      id: f.logoId,
      locale: @f.locale
    )
  }

  on Asset a {
    id
    url
    title
    kind
  }

  on Tabs t {
    id
    title
    expand tabs: each link in t.tabs (
      Tab(
        spaceId: @t.spaceId,
        environmentId: @t.environmentId,
        id: link.id,
        locale: @t.locale
      )
    )
  }

  on Tab tab {
    id
    title
    expand strips: each link in tab.strips (
      Entry(
        spaceId: @tab.spaceId,
        environmentId: @tab.environmentId,
        id: link.id,
        locale: @tab.locale
      )
    )
  }

  on Product prod {
    id
    sku
    title
  }
}
