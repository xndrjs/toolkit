query PageDetail(pageId: EntryId) {
  context {
    spaceId: SpaceId
    environmentId: EnvironmentId
    locale: Locale
  }

  root Page(
    spaceId: context.spaceId,
    environmentId: context.environmentId,
    id: pageId,
    locale: context.locale
  )

  on Page p {
    id
    title
    expand menu: Entry(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.menuId,
      locale: @p.locale
    )
    expand footer: Entry(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.footerId,
      locale: @p.locale
    )
    expand strips: each link in p.strips (
      Entry(
        spaceId: @p.spaceId,
        environmentId: @p.environmentId,
        id: link.id,
        locale: @p.locale
      )
    )
    expand related: each ref in p.related (
      CustomReference(
        ref: ref,
        locale: @p.locale
      )
    )
  }

  on Entry e {
    when e.type == "Hero" {
      type
      id
      title
      expand image: Asset(
        spaceId: context.spaceId,
        environmentId: context.environmentId,
        id: e.imageId,
        locale: @e.locale
      )
    }
    when e.type == "Tabs" {
      type
      id
      title
      expand tabs: each link in e.tabs (
        Entry(
          spaceId: @e.spaceId,
          environmentId: @e.environmentId,
          id: link.id,
          locale: @e.locale
        )
      )
    }
    when e.type == "Tab" {
      type
      id
      title
      expand strips: each link in e.strips (
        Entry(
          spaceId: @e.spaceId,
          environmentId: @e.environmentId,
          id: link.id,
          locale: @e.locale
        )
      )
    }
    when e.type == "Product" {
      type
      id
      sku
      title
    }
    when e.type == "Menu" {
      type
      id
      title
      expand logo: Asset(
        spaceId: context.spaceId,
        environmentId: context.environmentId,
        id: e.logoId,
        locale: @e.locale
      )
    }
    when e.type == "Footer" {
      type
      id
      title
      expand logo: Asset(
        spaceId: context.spaceId,
        environmentId: context.environmentId,
        id: e.logoId,
        locale: @e.locale
      )
    }
    when e.type == "SiteInternalLink" {
      type
      id
      expand target: Entry(
        spaceId: @e.spaceId,
        environmentId: @e.environmentId,
        id: e.targetId,
        locale: @e.locale
      )
    }
    when e.type == "Page" {
      type
      id
    }
  }

  on Asset a {
    id
    url
    title
    kind
  }
}
