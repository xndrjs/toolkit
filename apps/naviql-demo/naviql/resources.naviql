scalar Locale on string;
scalar SpaceId on string;
scalar EnvironmentId on string;
scalar EntryId on string;
scalar AssetId on string;
scalar CustomReferenceValue on string;
scalar Sku on string;

/** Canonical CMS entry address — content type is not part of identity. */
resource Entry(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): Hero | Tabs | Product

resource Asset(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: AssetId,
  locale: Locale
): {
  type: "Asset"
  id
  url: string
  title: string
  kind: "image" | "video" | "document"
}

/**
 * Legacy encoded locator (`{environmentId}@{spaceId}|ENTRY|id` or `|ASSET|id`).
 * Parses into the canonical Entry or Asset identity; does not invent a second identity.
 */
resource CustomReference(
  ref: CustomReferenceValue,
  locale: Locale
): Entry | Asset

resource Page(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  menuId: EntryId
  footerId: EntryId
  // Standard CMS links: entry id only — no content-type discriminant.
  strips: {
    id: EntryId
  }[]
  // Legacy custom references (same target may also appear as a standard link).
  related: CustomReferenceValue[]
}

resource Hero(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  type: "Hero"
  id
  title: string
  imageId: AssetId
}

resource Menu(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  logoId: AssetId
}

resource Footer(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  logoId: AssetId
}

resource Tabs(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  type: "Tabs"
  id
  title: string
  tabs: {
    id: EntryId
  }[]
}

resource Tab(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  strips: {
    id: EntryId
  }[]
}

resource Product(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  type: "Product"
  id
  sku: Sku
  title: string
}
