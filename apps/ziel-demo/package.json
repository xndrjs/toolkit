{
  "name": "@xndrjs/ziel-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "ziel:codegen": "ziel-codegen --config ./ziel.config.ts",
    "ziel:dev": "ziel-codegen --config ./ziel.config.ts --watch",
    "predev": "pnpm run ziel:codegen",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xndrjs/ziel": "workspace:^",
    "next": "^16.2.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  },
  "version": "0.0.1"
}
