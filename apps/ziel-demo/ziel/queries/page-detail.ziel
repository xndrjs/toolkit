/**
 * Chrome logo expand shared by Menu / Footer — `when` narrows so `logoId` is
 * valid on the fragment body; field include comes from the enclosing `on Entry`.
 * Soft-fail: replaces former global `missingResourceMode: "collect"`.
 */
fragment ChromeLogo on Entry e when e.kind == "Menu"
  or e.kind == "Footer" {
  expand logo: Asset(
    spaceId: @e.spaceId,
    environmentId: @e.environmentId,
    id: e.logoId,
    locale: @e.locale
  ) on failure set null
}

query FooQ(
  pageId: EntryId,
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  locale: Locale
) {
  context {
    environmentId
    spaceId
    locale
  }

  root Page(
    spaceId: spaceId,
    environmentId: environmentId,
    id: pageId,
    locale: locale
  )

  on Page p { }
}

query PageDetail(
  pageId: EntryId,
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  locale: Locale
) {
  context {
    spaceId
    environmentId
    locale
  }

  root Page(
    spaceId: spaceId,
    environmentId: environmentId,
    id: pageId,
    locale: locale
  )

  on Page p include properties {
    expand menu: Entry(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.menuId,
      locale: @p.locale
    ) on failure set null

    expand footer: Entry(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.footerId,
      locale: @p.locale
    ) on failure set null

    expand strips: each pageLink in p.strips (
      Entry(
        spaceId: @p.spaceId,
        environmentId: @p.environmentId,
        id: pageLink.id,
        locale: @p.locale
      ) on failure set null
    )

    expand related: each ref in p.related (
      CustomReference(
        ref: ref,
        locale: @p.locale
      ) on failure set null
    )

    // Singular object link whose fields jointly address TaxonomyTerm identity.
    expand primaryTerm: TaxonomyTerm(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      kind: p.primaryTerm.kind,
      id: p.primaryTerm.id,
      locale: @p.locale
    ) on failure set null

    expand relatedTerms: each termLink in p.relatedTerms (
      TaxonomyTerm(
        spaceId: @p.spaceId,
        environmentId: @p.environmentId,
        kind: termLink.kind,
        id: termLink.id,
        locale: @p.locale
      ) on failure set null
    )
  }

  on CustomReference c resolve to {
    Entry(
      spaceId: c.spaceId,
      environmentId: c.environmentId,
      id: c.id,
      locale: @c.locale
    ) when c.kind == "Entry"

    Asset(
      spaceId: c.spaceId,
      environmentId: c.environmentId,
      id: c.id,
      locale: @c.locale
    ) when c.kind == "Asset"
  }

  on Entry e include properties {
    when e.kind == "Hero" {
      expand image: Asset(
        spaceId: @e.spaceId,
        environmentId: @e.environmentId,
        id: e.imageId,
        locale: @e.locale
      ) on failure set null
    }

    when e.kind == "Tabs" {
      expand tabs: each tabLink in e.tabs (
        Entry(
          spaceId: @e.spaceId,
          environmentId: @e.environmentId,
          id: tabLink.id,
          locale: @e.locale
        ) on failure set null
      )
    }

    when e.kind == "Tab" {
      expand strips: each entryLink in e.strips (
        Entry(
          spaceId: @e.spaceId,
          environmentId: @e.environmentId,
          id: entryLink.id,
          locale: @e.locale
        ) on failure set null
      )
    }

    when e.kind == "Menu"
      or e.kind == "Footer" {
      ...ChromeLogo
    }

    when e.kind == "Product" {
      exclude id
    }

    when e.kind == "Page" { }

    when e.kind == "SiteInternalLink" {
      expand target: Entry(
        spaceId: @e.spaceId,
        environmentId: @e.environmentId,
        id: e.targetId,
        locale: @e.locale
      ) on failure set null
    }

    default { }
  }

  on Asset a include properties { }

  on TaxonomyTerm t include properties { }

  islands {
    on Entry e when e.kind == "Menu"
      or e.kind == "Footer"
  }
}
