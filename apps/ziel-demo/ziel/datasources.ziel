/**
 * Routing metadata for demo DataSources.
 * App code supplies `load` / batchSize / concurrency via per-query
 * `create{Query}DataSources` (e.g. `createPageDetailDataSources`).
 */

datasource CmsCustomReferences {
  context {
    spaceId: SpaceId
    environmentId: EnvironmentId
    locale: Locale
  }

  for CustomReference
}

datasource CmsEntries {
  context {
    spaceId: SpaceId
    environmentId: EnvironmentId
    locale: Locale
  }

  for Page
  for Entry
}

/**
 * Demo-only ErrorLab roots for the error-handling showcase.
 * Kept separate from CmsEntries so page-detail CMS loading stays clean.
 */
datasource ErrorLabStore {
  context {
    spaceId: SpaceId
    environmentId: EnvironmentId
    locale: Locale
  }

  for ErrorLab
}

datasource CmsAssets {
  context {
    spaceId: SpaceId
    environmentId: EnvironmentId
    locale: Locale
  }

  for Asset
}

datasource CmsTaxonomyTerms {
  context {
    spaceId: SpaceId
    environmentId: EnvironmentId
    locale: Locale
  }

  for TaxonomyTerm
}

datasource CatalogApi {
  context {
    market: Market
    locale: Locale
  }

  for CatalogProduct
}

datasource PricingApi {
  context {
    market: Market
  }

  for OfferPrice
}

datasource InventoryApi {
  context {
    tenantId: TenantId
  }

  for StockLevel
}

datasource MediaCdn {
  context {
    market: Market
  }

  for ProductMedia
}
