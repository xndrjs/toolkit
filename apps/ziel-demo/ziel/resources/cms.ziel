/**
 * Shared CMS / editorial identity and resource shapes.
 */

/** External payloads — Ziel carries them; composition root unwraps for UI. */
opaque RichDocument;

opaque MediaDescriptor;

scalar Locale on string;

scalar SpaceId on string;

scalar EnvironmentId on string;

scalar EntryId on string;

scalar AssetId on string;

scalar CustomReferenceValue on string;

scalar Sku on string;

scalar TermId on string;

scalar TaxonomyKind on string;

/**
 * Canonical CMS entry address — content type is not part of identity.
 * Payload is a closed discriminated object union (not rematerialized ARIs).
 */

resource Entry(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
):
  {
    kind: "Hero"
    id
    title: string
    body: RichDocument
    imageId: AssetId refers Asset
  }
  | {
    kind: "Tabs"
    id
    title: string
    tabs: {
      id: EntryId
    }[]
  }
  | {
    kind: "Tab"
    id
    title: string
    strips: {
      id: EntryId refers Entry
    }[]
  }
  | {
    kind: "Product"
    id
    sku: Sku
    title: string
  }
  | {
    kind: "Menu"
    id
    title: string
    logoId: AssetId refers Asset
  }
  | {
    kind: "Footer"
    id
    cta: string
    title: string
    logoId: AssetId refers Asset
  }
  | {
    kind: "Page"
    id
    title: string
  }
  | {
    kind: "SiteInternalLink"
    id
    targetId: EntryId refers Entry
  }

resource Asset(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: AssetId,
  locale: Locale
): {
  kind: "Asset"
  id
  url: string
  title: string
  asset_type: "image" | "video" | "document"
  descriptor: MediaDescriptor
}

/**
 * Taxonomy node addressed by a composite key (`kind` + `id`), not Entry identity.
 * Link objects carry both parts; space / environment / locale come from context.
 */

resource TaxonomyTerm(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  kind: TaxonomyKind,
  id: TermId,
  locale: Locale
): {
  kind
  id
  label: string
  slug: string
}

/**
 * Legacy encoded locator (`{environmentId}@{spaceId}|ENTRY|id` or `|ASSET|id`).
 * Decode payload only — redirect hops are declared in the query via `resolve to`.
 */

resource CustomReference(
  ref: CustomReferenceValue,
  locale: Locale
):
  {
    kind: "Entry"
    spaceId: SpaceId
    environmentId: EnvironmentId
    id: EntryId refers Entry
  }
  | {
    kind: "Asset"
    spaceId: SpaceId
    environmentId: EnvironmentId
    id: AssetId refers Asset
  }

/**
 * Root editorial page only. Linked pages are Entry payloads with `kind: "Page"`
 * (shallow — no strips/menu/footer) and are not loaded as Page ARIs.
 */

resource Page(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  menuId: EntryId refers Entry with {
    kind: "Menu"
  }
  footerId: EntryId refers Entry with {
    kind: "Footer"
  }
  // Standard CMS links: entry id only — no content-type discriminant.
  strips: {
    id: EntryId
  }[] refers Entry
  // Legacy custom references (same target may also appear as a standard link).
  related: CustomReferenceValue[] refers CustomReference
  // Composite-key link: both `kind` and `id` are identity parts of TaxonomyTerm.
  primaryTerm: {
    kind: TaxonomyKind
    id: TermId
  } refers TaxonomyTerm
  relatedTerms: {
    kind: TaxonomyKind
    id: TermId
  }[] refers TaxonomyTerm
}

/**
 * Demo-only root for per-edge `on failure` showcase (soft null / soft error / throw).
 * Identity shares the EntryId namespace with Page / Entry fixtures.
 */

resource ErrorLab(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  softSingleId: EntryId refers Entry
  errorSingleId: EntryId refers Entry
  throwSingleId: EntryId refers Entry
  softItems: {
    id: EntryId
  }[] refers Entry
  errorItems: {
    id: EntryId
  }[] refers Entry
  throwItems: {
    id: EntryId
  }[] refers Entry
}
