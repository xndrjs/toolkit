/**
 * Chrome logo expand shared by Menu / Footer — `when` narrows so `logoId` is
 * valid on the fragment body; field include comes from the enclosing `on Entry`.
 */
fragment ChromeLogo on Entry e when e.kind == "Menu"
  or e.kind == "Footer" {
  expand logo: Asset(
    spaceId: @e.spaceId,
    environmentId: @e.environmentId,
    id: e.logoId,
    locale: @e.locale
  )
}

query PageDetail(pageId: EntryId) {
  context {
    spaceId: SpaceId
    environmentId: EnvironmentId
    locale: Locale
  }

  root Page(
    spaceId: context.spaceId,
    environmentId: context.environmentId,
    id: pageId,
    locale: context.locale
  )

  on Page p include properties {
    expand menu: Entry(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.menuId,
      locale: @p.locale
    )
    expand footer: Entry(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.footerId,
      locale: @p.locale
    )
    expand strips: each link in p.strips (
      Entry(
        spaceId: @p.spaceId,
        environmentId: @p.environmentId,
        id: link.id,
        locale: @p.locale
      )
    )
    expand related: each ref in p.related (
      CustomReference(
        ref: ref,
        locale: @p.locale
      )
    )
  }

  on CustomReference c resolve to {
    Entry(
      spaceId: c.spaceId,
      environmentId: c.environmentId,
      id: c.id,
      locale: @c.locale
    ) when c.kind == "Entry"

    Asset(
      spaceId: c.spaceId,
      environmentId: c.environmentId,
      id: c.id,
      locale: @c.locale
    ) when c.kind == "Asset"
  }

  on Entry e include properties {
    when e.kind == "Hero" {
      expand image: Asset(
        spaceId: @e.spaceId,
        environmentId: @e.environmentId,
        id: e.imageId,
        locale: @e.locale
      )
    }

    when e.kind == "Tabs" {
      expand tabs: each link in e.tabs (
        Entry(
          spaceId: @e.spaceId,
          environmentId: @e.environmentId,
          id: link.id,
          locale: @e.locale
        )
      )
    }

    when e.kind == "Tab" {
      expand strips: each link in e.strips (
        Entry(
          spaceId: @e.spaceId,
          environmentId: @e.environmentId,
          id: link.id,
          locale: @e.locale
        )
      )
    }

    when e.kind == "Menu"
      or e.kind == "Footer" {
      ...ChromeLogo
    }

    when e.kind == "SiteInternalLink" {
      expand target: Entry(
        spaceId: @e.spaceId,
        environmentId: @e.environmentId,
        id: e.targetId,
        locale: @e.locale
      )
    }

    default { }
  }

  on Asset a include properties { }

  islands {
    on Entry e when e.kind == "Menu"
      or e.kind == "Footer"
  }
}
