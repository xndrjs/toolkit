{
  "extends": "../../tsconfig.repo.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["configs/**/*.ts", "generated/**/*.ts", "src/**/*.ts", "vitest.config.ts"]
}
