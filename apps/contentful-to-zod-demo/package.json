{
  "name": "@xndrjs/contentful-to-zod-demo",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "codegen:flat": "contentful-to-zod --config ./configs/flat.config.ts",
    "codegen:flat-localized": "contentful-to-zod --config ./configs/flat-localized.config.ts",
    "codegen:localized-only": "contentful-to-zod --config ./configs/localized-only.config.ts",
    "codegen:all-modes": "contentful-to-zod --config ./configs/all-modes.config.ts",
    "codegen": "pnpm run codegen:flat && pnpm run codegen:flat-localized && pnpm run codegen:localized-only && pnpm run codegen:all-modes",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@xndrjs/contentful-to-zod": "workspace:^",
    "typescript": "^5.7.3",
    "vitest": "^4.1.0"
  }
}
