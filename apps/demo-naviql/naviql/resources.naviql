scalar Locale on string;
scalar PageId on string;
scalar HeroId on string;
scalar MenuId on string;
scalar FooterId on string;
scalar AssetId on string;
scalar TabsId on string;
scalar TabId on string;
scalar ProductId on string;
scalar Sku on string;

resource Page(id: PageId, locale: Locale): {
  id
  title: string
  menuId: MenuId
  footerId: FooterId
  // Polymorphic module stubs — discriminant + branded id per arm.
  strips: (
    { type: "Hero", id: HeroId } |
    { type: "Tabs", id: TabsId } |
    { type: "Product", id: ProductId }
  )[]
}

resource Hero(id: HeroId, locale: Locale): {
  type: "Hero"
  id
  title: string
  imageId: AssetId
}

resource Menu(id: MenuId, locale: Locale): {
  id
  title: string
  logoId: AssetId
}

resource Footer(id: FooterId, locale: Locale): {
  id
  title: string
  logoId: AssetId
}

resource Asset(id: AssetId, locale: Locale): {
  id
  url: string
  title: string
  kind: "image" | "video" | "document"
}

resource Tabs(id: TabsId, locale: Locale): {
  type: "Tabs"
  id
  title: string
}

resource Tab(id: TabId, locale: Locale): {
  id
  title: string
  // Same polymorphic stubs as Page.strips (Tabs nesting / recursion).
  strips: (
    { type: "Hero", id: HeroId } |
    { type: "Tabs", id: TabsId } |
    { type: "Product", id: ProductId }
  )[]
}

/** Collection resource: resolves to Tab instances (normalized into the graph). */
resource TabCollection(tabsId: TabsId, locale: Locale): Tab[]

resource Product(id: ProductId, locale: Locale): {
  type: "Product"
  id
  sku: Sku
  title: string
}
