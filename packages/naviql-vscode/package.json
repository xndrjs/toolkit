{
  "name": "naviql-vscode",
  "displayName": "NaviQL",
  "description": "Syntax highlighting and diagnostics for NaviQL (.naviql) files.",
  "version": "0.0.1",
  "publisher": "xndrjs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "naviql",
    "syntax",
    "highlighting",
    "diagnostics",
    "lsp",
    "graphql"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xndrjs/toolkit.git",
    "directory": "packages/naviql-vscode"
  },
  "bugs": {
    "url": "https://github.com/xndrjs/toolkit/issues"
  },
  "homepage": "https://github.com/xndrjs/toolkit/tree/main/packages/naviql-vscode",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:naviql"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "vsix": "pnpm run build && npx --yes @vscode/vsce package --no-dependencies",
    "publish:vscode": "pnpm run build && npx --yes @vscode/vsce publish --no-dependencies",
    "publish:ovsx": "pnpm run build && npx --yes ovsx publish --no-dependencies"
  },
  "dependencies": {
    "@xndrjs/naviql": "workspace:^",
    "vscode-languageclient": "~10.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.91.0",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "naviql",
        "aliases": [
          "NaviQL",
          "naviql"
        ],
        "extensions": [
          ".naviql"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "naviql",
        "scopeName": "source.naviql",
        "path": "./syntaxes/naviql.tmLanguage.json"
      }
    ]
  }
}
