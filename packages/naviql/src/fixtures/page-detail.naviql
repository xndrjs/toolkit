scalar Locale on string;
scalar SpaceId on string;
scalar EnvironmentId on string;
scalar EntryId on string;
scalar AssetId on string;
scalar CustomReferenceValue on string;
scalar Sku on string;

/**
 * Canonical CMS entry address — content type is not part of identity.
 * Payload is a closed discriminated object union (not rematerialized ARIs).
 */
resource Entry(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
):
  {
    type: "Hero"
    id
    title: string
    imageId: AssetId
  }
  | {
    type: "Tabs"
    id
    title: string
    tabs: {
      id: EntryId
    }[]
  }
  | {
    type: "Tab"
    id
    title: string
    strips: {
      id: EntryId
    }[]
  }
  | {
    type: "Product"
    id
    sku: Sku
    title: string
  }
  | {
    type: "Menu"
    id
    title: string
    logoId: AssetId
  }
  | {
    type: "Footer"
    id
    title: string
    logoId: AssetId
  }
  | {
    type: "Page"
    id
    title: string
  }
  | {
    type: "SiteInternalLink"
    id
    targetId: EntryId
  }

resource Asset(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: AssetId,
  locale: Locale
): {
  type: "Asset"
  id
  url: string
  title: string
  kind: "image" | "video" | "document"
}

/**
 * Legacy encoded locator (`{environmentId}@{spaceId}|ENTRY|id` or `|ASSET|id`).
 * Parses into the canonical Entry or Asset identity; does not invent a second identity.
 */
resource CustomReference(
  ref: CustomReferenceValue,
  locale: Locale
): Entry | Asset

/**
 * Root editorial page only. Linked pages are Entry payloads with `type: "Page"`
 * (shallow — no strips/menu/footer) and are not loaded as Page ARIs.
 */
resource Page(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  menuId: EntryId
  footerId: EntryId
  // Standard CMS links: entry id only — no content-type discriminant.
  strips: {
    id: EntryId
  }[]
  // Legacy custom references (same target may also appear as a standard link).
  related: CustomReferenceValue[]
}

fragment EntryBase on Entry e {
  type
  id
}

fragment BrandChrome on Entry e {
  title
  expand logo: Asset(
    spaceId: context.spaceId,
    environmentId: context.environmentId,
    id: e.logoId,
    locale: @e.locale
  )
}

query PageDetail(pageId: EntryId) {
  context {
    spaceId: SpaceId
    environmentId: EnvironmentId
    locale: Locale
  }

  root Page(
    spaceId: context.spaceId,
    environmentId: context.environmentId,
    id: pageId,
    locale: context.locale
  )

  on Page p {
    id
    title
    expand menu: Entry(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.menuId,
      locale: @p.locale
    )
    expand footer: Entry(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.footerId,
      locale: @p.locale
    )
    expand strips: each link in p.strips (
      Entry(
        spaceId: @p.spaceId,
        environmentId: @p.environmentId,
        id: link.id,
        locale: @p.locale
      )
    )
    expand related: each ref in p.related (
      CustomReference(
        ref: ref,
        locale: @p.locale
      )
    )
  }

  on Entry e {
    ...EntryBase
    when e.type == "Hero" {
      title
      expand image: Asset(
        spaceId: context.spaceId,
        environmentId: context.environmentId,
        id: e.imageId,
        locale: @e.locale
      )
    }
    when e.type == "Tabs" {
      title
      expand tabs: each link in e.tabs (
        Entry(
          spaceId: @e.spaceId,
          environmentId: @e.environmentId,
          id: link.id,
          locale: @e.locale
        )
      )
    }
    when e.type == "Tab" {
      title
      expand strips: each link in e.strips (
        Entry(
          spaceId: @e.spaceId,
          environmentId: @e.environmentId,
          id: link.id,
          locale: @e.locale
        )
      )
    }
    when e.type == "Product" {
      sku
      title
    }
    when e.type == "Menu" {
      ...BrandChrome
    }
    when e.type == "Footer" {
      ...BrandChrome
    }
    when e.type == "SiteInternalLink" {
      expand target: Entry(
        spaceId: @e.spaceId,
        environmentId: @e.environmentId,
        id: e.targetId,
        locale: @e.locale
      )
    }
    when e.type == "Page" {
    }
  }

  on Asset a {
    id
    url
    title
    kind
  }
}
