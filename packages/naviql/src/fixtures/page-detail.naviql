scalar Locale on string;
scalar SpaceId on string;
scalar EnvironmentId on string;
scalar EntryId on string;
scalar AssetId on string;
scalar CustomReferenceValue on string;
scalar Sku on string;

/** Canonical CMS entry address — content type is not part of identity. */
resource Entry(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): Hero | Tabs | Product

resource Asset(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: AssetId,
  locale: Locale
): {
  type: "Asset"
  id
  url: string
  title: string
  kind: "image" | "video" | "document"
}

/**
 * Legacy encoded locator (`{environmentId}@{spaceId}|ENTRY|id` or `|ASSET|id`).
 * Parses into the canonical Entry or Asset identity; does not invent a second identity.
 */
resource CustomReference(
  ref: CustomReferenceValue,
  locale: Locale
): Entry | Asset

resource Page(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  menuId: EntryId
  footerId: EntryId
  // Standard CMS links: entry id only — no content-type discriminant.
  strips: {
    id: EntryId
  }[]
  // Legacy custom references (same target may also appear as a standard link).
  related: CustomReferenceValue[]
}

resource Hero(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  type: "Hero"
  id
  title: string
  imageId: AssetId
}

resource Menu(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  logoId: AssetId
}

resource Footer(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  logoId: AssetId
}

resource Tabs(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  type: "Tabs"
  id
  title: string
  // Same link shape as Page.strips / Tab.strips — entry id only.
  tabs: {
    id: EntryId
  }[]
}

resource Tab(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  id
  title: string
  strips: {
    id: EntryId
  }[]
}

resource Product(
  spaceId: SpaceId,
  environmentId: EnvironmentId,
  id: EntryId,
  locale: Locale
): {
  type: "Product"
  id
  sku: Sku
  title: string
}
query PageDetail(pageId: EntryId) {
  context {
    spaceId: SpaceId
    environmentId: EnvironmentId
    locale: Locale
  }

  root Page(
    spaceId: context.spaceId,
    environmentId: context.environmentId,
    id: pageId,
    locale: context.locale
  )

  on Page p {
    id
    title
    expand menu: Menu(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.menuId,
      locale: @p.locale
    )
    expand footer: Footer(
      spaceId: @p.spaceId,
      environmentId: @p.environmentId,
      id: p.footerId,
      locale: @p.locale
    )
    expand strips: each link in p.strips (
      Entry(
        spaceId: @p.spaceId,
        environmentId: @p.environmentId,
        id: link.id,
        locale: @p.locale
      )
    )
    expand related: each ref in p.related (
      CustomReference(
        ref: ref,
        locale: @p.locale
      )
    )
  }

  on Hero h {
    id
    title
    expand image: Asset(
      spaceId: context.spaceId,
      environmentId: context.environmentId,
      id: h.imageId,
      locale: @h.locale
    )
  }

  on Menu m {
    id
    title
    expand logo: Asset(
      spaceId: context.spaceId,
      environmentId: context.environmentId,
      id: m.logoId,
      locale: @m.locale
    )
  }

  on Footer f {
    id
    title
    expand logo: Asset(
      spaceId: context.spaceId,
      environmentId: context.environmentId,
      id: f.logoId,
      locale: @f.locale
    )
  }

  on Asset a {
    id
    url
    title
    kind
  }

  on Tabs t {
    id
    title
    expand tabs: each link in t.tabs (
      Tab(
        spaceId: @t.spaceId,
        environmentId: @t.environmentId,
        id: link.id,
        locale: @t.locale
      )
    )
  }

  on Tab tab {
    id
    title
    expand strips: each link in tab.strips (
      Entry(
        spaceId: @tab.spaceId,
        environmentId: @tab.environmentId,
        id: link.id,
        locale: @tab.locale
      )
    )
  }

  on Product prod {
    id
    sku
    title
  }
}
