{
  "name": "@xndrjs/plop-os",
  "version": "0.0.0",
  "description": "Plop on steroids: scaffolding, codebase discovery, and explicit region sync.",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xndrjs/toolkit.git",
    "directory": "packages/plop-os"
  },
  "type": "module",
  "bin": {
    "plop-os": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24 <26"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "pack": "pnpm run build && mkdir -p artifacts && npm pack --pack-destination artifacts",
    "prepublishOnly": "pnpm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "plop": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "plop": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "node-plop": "^0.32.3",
    "path-to-regexp": "^9.0.0"
  }
}
